# Optional API keys. The agent works without any of these (it falls back to
# seed estimates + deep links), but live data gets better with each one you add.
# Copy to .env and fill in what you have. Never commit .env.

# SerpAPI (https://serpapi.com) - Google Flights results = live prices for ALL
# carriers (incl. American, Delta, Southwest, Breeze). Preferred cash-fare
# source; free tier is ~100-250 searches/month.
SERPAPI_KEY=

# Amadeus Self-Service (free tier) - fallback cash airfare search.
# CAVEAT: its content typically excludes AA, Delta, Southwest, Breeze and LCCs,
# so prices skew toward United and partners only.
# Sign up at https://developers.amadeus.com (Self-Service, free quota).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (default, free sandbox) or "production"
AMADEUS_ENV=test

# Seats.aero Partner API - live award (miles) availability. Requires a Pro
# subscription API key from https://seats.aero
SEATS_AERO_API_KEY=

# Apify flight-award-scraper - alternative/additional live award source.
# Get a token at https://console.apify.com/account/integrations (Personal API
# token). The app calls igolaizola/flight-award-scraper per route pair; each run
# uses Apify credits, and the actor only covers departures within ~60 days.
# If both this and SEATS_AERO_API_KEY are set, results are merged (cheapest wins).
APIFY_TOKEN=

# Dashboard port (default 8787)
PORT=

# RapidAPI (priceline-com-provider) - live Priceline EXPRESS DEALS rates for the
# SF hotels section. Subscribe at https://rapidapi.com/tipsters/api/priceline-com-provider
# then paste the key here. Read-only: you still book on priceline.com.
RAPIDAPI_KEY=
